# LocalSpotter has no settings at the repository root: nothing reads a .env file here.
# Each app has its own example file. Copy it next to itself and fill it in:
#
#   backend/.env.example   -> backend/.env          (database, JWT secret, email, SMS, payments, uploads, ...)
#   frontend/.env.example  -> frontend/.env.local   (BACKEND_URL and the public NEXT_PUBLIC_* values)
#
#   cp backend/.env.example backend/.env
#   cp frontend/.env.example frontend/.env.local
#
# Never commit the copies: .env and .env.local are git-ignored because they hold secrets.
