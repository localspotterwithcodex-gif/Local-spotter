# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"

# JWT Authentication
JWT_SECRET=localspotter_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma-separated for multiple; must include your deployed frontend URL)
CORS_ORIGIN=http://localhost:3000,https://local-spotter-ten.vercel.app

# Platform Settings
PLATFORM_COMMISSION_PERCENTAGE=0
FLAT_SHIPPING_FEE=3.95
