# ---- Server ----
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
# Set to 1 when running behind a reverse proxy / the Next.js rewrite
TRUST_PROXY=1

# ---- Database (PostgreSQL via Prisma) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"
# Direct (non-pooled) connection for migrations when using a pooler (e.g. Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"

# ---- Auth (REQUIRED — the app refuses to start without a strong secret) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Session cookie is HttpOnly + SameSite=Lax; Secure is forced when NODE_ENV=production
# (set COOKIE_SECURE=true to force it elsewhere, e.g. HTTPS staging)
COOKIE_SECURE=false

# ---- CORS / frontend (comma-separated origins; also used for the CSRF origin check) ----
CORS_ORIGIN=http://localhost:3000
# Used to build password-reset links (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:3000

# ---- Email / SMS delivery ----
# Local development: MAIL_TRANSPORT=dev-file writes messages (verification codes, reset links)
# to backend/.dev-outbox/*.json instead of sending them. Rejected when NODE_ENV=production.
# Production: MAIL_TRANSPORT=resend with RESEND_API_KEY and MAIL_FROM (sender on a domain
# verified in Resend). SMS is not implemented; mobile-number signup returns 503.
MAIL_TRANSPORT=dev-file
# RESEND_API_KEY=
# MAIL_FROM="LocalSpotter <no-reply@your-verified-domain>"

# ---- Image uploads (Cloudinary, free plan) ----
# Without these, POST /media/images answers 503 and owners cannot upload photos.
# Cloudinary dashboard -> Settings -> API Keys. The secret stays on the server only.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Automatic EN/NL translation of owner content (DeepL API Free) ----
# Optional: without a key, content is saved and shown exactly as typed (no auto-translation).
# Keys ending in ":fx" use the free endpoint automatically.
# DEEPL_API_KEY=

# ---- Platform settings ----
PLATFORM_COMMISSION_PERCENTAGE=0
FLAT_SHIPPING_FEE=3.95

# Interactive Prisma transaction limits (ms). Raise if the database is far from the API.
# PRISMA_TX_MAX_WAIT_MS=10000
# PRISMA_TX_TIMEOUT_MS=20000

# Social login (optional - buttons only appear when the matching NEXT_PUBLIC_* id is set on the frontend)
# GOOGLE_CLIENT_ID=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Public frontend URL used in the Facebook data-deletion callback response (defaults to the first CORS_ORIGIN)
# FRONTEND_URL=

# Pilot only: lets a shop activate its chosen plan without a payment (payment provider decision D-004 is open).
# In production a chosen plan otherwise stays INCOMPLETE and product creation is refused.
# ALLOW_UNPAID_SUBSCRIPTION_ACTIVATION=true
