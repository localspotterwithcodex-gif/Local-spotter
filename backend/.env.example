# ---- Server ----
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
# Set to 1 when running behind a reverse proxy / the Next.js rewrite
TRUST_PROXY=1

# ---- Database (PostgreSQL via Prisma) ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"
# Direct (non-pooled) connection for migrations when using a pooler (e.g. Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"

# ---- Auth (REQUIRED — the app refuses to start without a strong secret) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Session cookie is HttpOnly + SameSite=Lax; Secure is forced when NODE_ENV=production
# (set COOKIE_SECURE=true to force it elsewhere, e.g. HTTPS staging)
COOKIE_SECURE=false

# ---- CORS / frontend (comma-separated origins; also used for the CSRF origin check) ----
CORS_ORIGIN=http://localhost:3000
# Used to build password-reset links (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:3000

# ---- Email / SMS delivery ----
# Local development: MAIL_TRANSPORT=dev-file writes messages (verification codes, reset links)
# to backend/.dev-outbox/*.json instead of sending them. Rejected when NODE_ENV=production.
# Production: MAIL_TRANSPORT=resend with RESEND_API_KEY and MAIL_FROM (sender on a domain
# verified in Resend). SMS is not implemented; mobile-number signup returns 503.
MAIL_TRANSPORT=dev-file
# RESEND_API_KEY=
# MAIL_FROM="LocalSpotter <no-reply@your-verified-domain>"

# ---- Image uploads (Cloudinary, free plan) ----
# Without these, POST /media/images answers 503 and owners cannot upload photos.
# Cloudinary dashboard -> Settings -> API Keys. The secret stays on the server only.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Automatic EN/NL translation of owner content (DeepL API Free) ----
# Optional: without a key, content is saved and shown exactly as typed (no auto-translation).
# Keys ending in ":fx" use the free endpoint automatically.
# DEEPL_API_KEY=

# ---- Platform settings ----
FLAT_SHIPPING_FEE=3.95

# Interactive Prisma transaction limits (ms). Raise if the database is far from the API.
# PRISMA_TX_MAX_WAIT_MS=10000
# PRISMA_TX_TIMEOUT_MS=20000

# Social login (optional - buttons only appear when the matching NEXT_PUBLIC_* id is set on the frontend)
# GOOGLE_CLIENT_ID=
# Public frontend URL (links in e-mails, payment return page; defaults to the first CORS_ORIGIN)
# FRONTEND_URL=

# Payments: iDEAL through Stripe Checkout. Without STRIPE_SECRET_KEY no payment can start; outside production a
# chosen plan then activates without payment so development still works. In production a plan only becomes ACTIVE
# after a verified payment. Test keys start with sk_test_, live keys with sk_live_. Never commit a key.
# STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint {API_PUBLIC_URL}/api/v1/payments/webhooks/stripe, created in the
# Stripe dashboard (Developers > Webhooks) for the events checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded and checkout.session.async_payment_failed. Required in production.
# STRIPE_WEBHOOK_SECRET=
# Public https URL of this API (used for the webhook endpoint above).
# API_PUBLIC_URL=https://api.example.com

# Secret for internal job endpoints (chat retention, later payouts). Min 16 chars; unset = jobs disabled.
# Called by an external scheduler: curl -X POST -H "x-cron-secret: $CRON_SECRET" https://<api>/api/v1/internal/jobs/chat-retention
# Also: POST .../internal/jobs/subscription-reminders (daily; 7-day expiry reminder, once per subscription period)
#       POST .../internal/jobs/expire-unpaid-orders and .../expire-unpaid-bookings (every 10 minutes; releases stock/seats of unpaid checkouts after 30 minutes)
# CRON_SECRET=

# ---- Commission, payouts, returns ----
# Encrypts store bank details (IBAN) at rest with AES-256-GCM. base64 of exactly 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it owners cannot save a bank account and the admin payout export is disabled. Losing the key makes saved IBANs unreadable.
# ENCRYPTION_KEY=
# Default platform commission in basis points (500 = 5%) when a plan has no rate of its own (admin: Commission page). 0-5000.
# COMMISSION_DEFAULT_BPS=0
# Days a sale is on hold before it is available for payout (covers refunds/returns). 0-90.
# PAYOUT_HOLD_DAYS=14
# Smallest weekly payout in cents; smaller balances roll over to the next week.
# PAYOUT_MIN_CENTS=1000
# Days after delivery in which a customer may request a return. 1-90.
# RETURN_WINDOW_DAYS=14
# More scheduled jobs (same x-cron-secret header):
#       POST .../internal/jobs/weekly-payouts (weekly, e.g. Monday 06:00; creates PENDING payouts, an admin transfers and marks them paid)
#       POST .../internal/jobs/cleanup-guests (daily; removes guest accounts that never completed a checkout)
