# ---- Server ----
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
# Number of proxy hops in front of the API, so rate limits see the real client IP.
# Vercel rewrite -> Render load balancer -> API = 2. Unset in production = all visitors share one IP (warned at startup).
TRUST_PROXY=1
# Swagger UI at /api/v1/docs is off in production unless this is true.
# SWAGGER_ENABLED=false

# ---- Database (PostgreSQL via Prisma) ----
# Local database with Docker (matches the URLs below), then: npx prisma migrate deploy && ALLOW_DEMO_SEED=yes npx prisma db seed
#   docker run -d --name localspotter-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=localspotter -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"
# Direct (non-pooled) connection for migrations when using a pooler (e.g. Supabase)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/localspotter?schema=public"
# End-to-end tests only (npm run test:e2e): a separate, disposable database on a different host than DATABASE_URL.
# The tests write to it; the script refuses to run when it shares a server with DATABASE_URL or DIRECT_URL.
# TEST_DATABASE_URL=
# Optional; defaults to TEST_DATABASE_URL without the pooler.
# TEST_DATABASE_DIRECT_URL=

# ---- Auth (REQUIRED — the app refuses to start without a strong secret) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Session cookie is HttpOnly + SameSite=Lax; Secure is forced when NODE_ENV=production
# (set COOKIE_SECURE=true to force it elsewhere, e.g. HTTPS staging)
COOKIE_SECURE=false

# ---- CORS / frontend (comma-separated origins; also used for the CSRF origin check) ----
CORS_ORIGIN=http://localhost:3000
# Used to build password-reset links (defaults to the first CORS_ORIGIN)
FRONTEND_URL=http://localhost:3000

# ---- Email / SMS delivery ----
# Local development: MAIL_TRANSPORT=dev-file writes messages (verification codes, reset links)
# to backend/.dev-outbox/*.json instead of sending them. Rejected when NODE_ENV=production.
# Production: MAIL_TRANSPORT=resend with RESEND_API_KEY and MAIL_FROM (sender on a domain
# verified in Resend).
MAIL_TRANSPORT=dev-file
# RESEND_API_KEY=
# MAIL_FROM="LocalSpotter <no-reply@your-verified-domain>"

# ---- SMS: codes for sign-up, login and password reset, and order updates (Bird) ----
# Required in production. Locally (unset) every SMS is written to backend/.dev-outbox/ instead of being sent.
# Bird dashboard: enable the Netherlands under SMS -> Destinations, create an API key with only the SMS-sending
# scope (bk_eu1_... keys use the EU host below), choose a sender (3-11 characters, e.g. LocalSpotter).
# SMS_PROVIDER=bird
# BIRD_API_KEY=
# BIRD_API_BASE_URL=https://eu1.platform.bird.com
# BIRD_SMS_FROM=LocalSpotter
# Countries that may receive SMS codes (comma-separated prefixes; default: the sign-up country selector).
# SMS_ALLOWED_PREFIXES=+31,+32,+49
# Key for the HMAC of one-time codes (only the HMAC is stored). Required in production, 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OTP_HMAC_SECRET=
# Login SMS code: days a device stays trusted after a correct code (0 = a code on every login, D1). Max 90.
# LOGIN_OTP_TRUST_DAYS=0
# Temporary fallback until Bird is verified on staging: Twilio Verify (all three or none), used only when
# SMS_PROVIDER is not set. Remove once Bird works.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ---- File storage: Supabase Storage (MASTER-PROMPT Phase 4) ----
# STORAGE_PROVIDER=supabase: browsers upload straight to Supabase with a signed URL from POST /media/upload-ticket.
# Create the buckets once per environment: npx ts-node scripts/storage-buckets.ts
# The service-role key stays on the API only. Unset = Cloudinary below (kept until staging is verified).
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Image uploads (Cloudinary, free plan) ----
# Without these, POST /media/images answers 503 and owners cannot upload photos.
# Cloudinary dashboard -> Settings -> API Keys. The secret stays on the server only.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ---- Automatic EN/NL translation of owner content (DeepL API Free) ----
# Optional: without a key, content is saved and shown exactly as typed (no auto-translation).
# Keys ending in ":fx" use the free endpoint automatically.
# DEEPL_API_KEY=
# Photo search (free key from https://aistudio.google.com/apikey); without it the camera search is unavailable
# GEMINI_API_KEY=
# Optional model override for photo search (default gemini-3.1-flash-lite)
# GEMINI_VISION_MODEL=

# ---- Platform settings ----
FLAT_SHIPPING_FEE=3.95

# Interactive Prisma transaction limits (ms). Raise if the database is far from the API.
# PRISMA_TX_MAX_WAIT_MS=10000
# PRISMA_TX_TIMEOUT_MS=20000

# Social login (optional - buttons only appear when the matching NEXT_PUBLIC_* id is set on the frontend)
# GOOGLE_CLIENT_ID=
# Public frontend URL (links in e-mails, payment return page; defaults to the first CORS_ORIGIN)
# FRONTEND_URL=

# Payments: iDEAL through Stripe Checkout. Without STRIPE_SECRET_KEY no payment can start; outside production a
# chosen plan then activates without payment so development still works. In production a plan only becomes ACTIVE
# after a verified payment. Test keys start with sk_test_, live keys with sk_live_. Never commit a key.
# STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook endpoint https://<public API origin>/api/v1/payments/webhooks/stripe, created in the
# Stripe dashboard (Developers > Webhooks) for the events checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded and checkout.session.async_payment_failed. Required in production.
# STRIPE_WEBHOOK_SECRET=

# Secret for internal job endpoints (chat retention, later payouts). Min 16 chars; unset = jobs disabled.
# On Vercel: set CRON_SECRET in the API project; Vercel Cron calls the schedules in backend/vercel.json with GET and
# "Authorization: Bearer $CRON_SECRET" (production deployments only, times in UTC). Any other scheduler can call
#   curl -X POST -H "x-cron-secret: $CRON_SECRET" https://<api>/api/v1/internal/jobs/chat-retention
# Also: POST .../internal/jobs/subscription-reminders (daily; 7-day expiry reminder, once per subscription period)
#       POST .../internal/jobs/expire-unpaid-orders and .../expire-unpaid-bookings (every 10 minutes; releases stock/seats of unpaid checkouts after 30 minutes)
# CRON_SECRET=

# ---- Commission, payouts, returns ----
# Encrypts store bank details (IBAN) at rest with AES-256-GCM. base64 of exactly 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it owners cannot save a bank account and the admin payout export is disabled. Losing the key makes saved IBANs unreadable.
# Also encrypts admin two-step (TOTP) secrets: REQUIRED in production, otherwise admins cannot enrol and the admin portal stays locked.
# ENCRYPTION_KEY=
# Default platform commission in basis points (500 = 5%) when a plan has no rate of its own (admin: Commission page). 0-5000.
# COMMISSION_DEFAULT_BPS=0
# Days a sale is on hold before it is available for payout (covers refunds/returns). 0-90.
# PAYOUT_HOLD_DAYS=14
# Smallest weekly payout in cents; smaller balances roll over to the next week.
# PAYOUT_MIN_CENTS=1000
# Days after delivery in which a customer may request a return. 1-90.
# RETURN_WINDOW_DAYS=14
# More scheduled jobs (same x-cron-secret header):
#       POST .../internal/jobs/weekly-payouts (weekly, e.g. Monday 06:00; creates PENDING payouts, an admin transfers and marks them paid)
#       POST .../internal/jobs/cleanup-guests (daily; removes guest accounts that never completed a checkout)

# ---- First setup of a new database (scripts only) ----
# npx ts-node scripts/seed-plans.ts --webshop=<price> --shoproutes=<price> --workshop=<price>   (safe to re-run)
# ADMIN_EMAIL=you@your-domain.nl npx ts-node scripts/create-admin.ts   (first super admin; password typed, hidden)
# ADMIN_EMAIL=

# ---- Demo data (scripts only; never set these in production) ----
# prisma db seed creates demo accounts with publicly known passwords and refuses to run unless ALLOW_DEMO_SEED=yes.
# ALLOW_DEMO_SEED=
# npm run demo:products:remove -- --apply only deletes demo products when ALLOW_DEMO_CLEANUP=yes.
# ALLOW_DEMO_CLEANUP=
