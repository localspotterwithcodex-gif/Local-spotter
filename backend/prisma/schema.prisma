datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  CONSUMER
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum BusinessStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SubscriptionPlanSlug {
  WEBSHOP
  SHOPROUTES
  WORKSHOP
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  MOLLIE
  STRIPE
  PAYPAL
  TIKKIE
  MANUAL
}

enum PaymentMethod {
  IDEAL
  PAYPAL
  TIKKIE
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentPurpose {
  BUSINESS_SUBSCRIPTION
  PRODUCT_ORDER
  WORKSHOP_BOOKING
}

enum FulfilmentMethod {
  PICKUP
  SHIPPING
  LOCAL_DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REJECTED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum WorkshopStatus {
  DRAFT
  PUBLISHED
  FULL
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  OPEN
  FULL
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum RouteStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum NotificationType {
  ORDER
  BOOKING
  FOLLOWER
  REVIEW
  PAYOUT
  SUBSCRIPTION
  SYSTEM
  CHAT
  RETURN
}

// ==========================================
// IDENTITY & USERS
// ==========================================

model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String?      @unique
  mobile            String?      @unique
  username          String?      @unique
  passwordHash      String?      @map("password_hash")
  role              UserRole
  status            UserStatus   @default(ACTIVE)
  emailVerifiedAt   DateTime?    @map("email_verified_at")
  mobileVerifiedAt  DateTime?    @map("mobile_verified_at")
  verificationCode  String?      @map("verification_code")
  verificationCodeExpiresAt DateTime? @map("verification_code_expires_at")
  verificationAttempts Int         @default(0) @map("verification_attempts")
  lastLoginAt       DateTime?    @map("last_login_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  deletedAt         DateTime?    @map("deleted_at")
  /// Consent record: when and which terms/privacy version the user accepted at registration.
  consentAcceptedAt DateTime?    @map("consent_accepted_at")
  consentVersion    String?      @map("consent_version")
  /// Password-less shadow account created at guest checkout (no login; access via emailed link).
  isGuest           Boolean      @default(false) @map("is_guest")
  /// Contact e-mail of a guest. users.email stays empty until the guest claims a real account.
  guestEmail        String?      @map("guest_email")

  oauthAccounts       OAuthAccount[]
  passwordResetTokens PasswordResetToken[]
  consumerProfile     ConsumerProfile?
  businessOwnerProfile BusinessOwnerProfile?
  notifications       Notification[]
  notificationPreference NotificationPreference?
  chatMessages        ChatMessage[]
  chatReports         ChatReport[]    @relation("ChatReportReporter")
  employeeships       MerchantEmployee[] @relation("EmployeeUser")
  payments            Payment[]
  auditLogs           AuditLog[]   @relation("AuditLogActor")
  comments            Comment[]
  payoutsRequested    Payout[]     @relation("PayoutRequestedBy")
  payoutsApproved     Payout[]     @relation("PayoutApprovedBy")
  reportsAsReporter   Report[]     @relation("ReportReporter")
  reportsAsResolved   Report[]     @relation("ReportResolvedBy")

  @@index([isGuest, createdAt])
  @@index([guestEmail])
  @@map("users")
}

model OAuthAccount {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  provider          String
  providerAccountId String    @map("provider_account_id")
  accessTokenHash   String?   @map("access_token_hash")
  refreshTokenHash  String?   @map("refresh_token_hash")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model ConsumerProfile {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @unique @map("user_id") @db.Uuid
  displayName         String       @map("display_name")
  firstName           String?      @map("first_name")
  lastName            String?      @map("last_name")
  phone               String?
  profileImageAssetId String?      @map("profile_image_asset_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

   user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
   profileImageAsset MediaAsset?       @relation(fields: [profileImageAssetId], references: [id])
   orders           Order[]
  customerOrders   CustomerOrder[]
   conversations    Conversation[]
   reviews          Review[]
   followers        Follower[]
   favorites        Favorite[]
   workshopBookings WorkshopBooking[]
   carts            Cart[]
   consumerAddresses ConsumerAddress[]
   returnRequests   ReturnRequest[]

   @@map("consumer_profiles")
}

model BusinessOwnerProfile {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String       @unique @map("user_id") @db.Uuid
  displayName         String       @map("display_name")
  phone               String?
  profileImageAssetId String?      @map("profile_image_asset_id") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileImageAsset MediaAsset? @relation(fields: [profileImageAssetId], references: [id])
  businesses       Business[]

  @@map("business_owner_profiles")
}

// ==========================================
// BUSINESS ENTITIES
// ==========================================

model Business {
  id             String         @id @default(uuid()) @db.Uuid
  ownerProfileId String         @map("owner_profile_id") @db.Uuid
  name           String
  slug           String         @unique
  description    String?
  phone          String?
  email          String?
  kvkNumber      String         @map("kvk_number")
  categoryId     String?        @map("category_id") @db.Uuid
  logoAssetId    String?        @map("logo_asset_id") @db.Uuid
  coverAssetId   String?        @map("cover_asset_id") @db.Uuid
  /// Equirectangular 360° photo of the shop interior (virtual store).
  panoramaAssetId String?       @map("panorama_asset_id") @db.Uuid
  videoAssetId    String?       @map("video_asset_id") @db.Uuid
  state          String
  city           String
  street         String
  houseNumber    String?        @map("house_number")
  postalCode     String?        @map("postal_code")
  // NOTE: `street`/`houseNumber` are kept internally for backward
  // compatibility with existing rows, but the frontend onboarding form
  // (PROMPT.md item 4) now collects a single free-text `address` field
  // (optionally filled via GPS reverse-geocoding) instead of two separate
  // inputs. New code should read/write `address`; `street` is populated
  // from it for storage-layer compatibility until a full migration
  // consolidates these columns.
  address        String?
  countryCode    String         @default("NL") @map("country_code")
  latitude       Decimal?       @db.Decimal(9, 6)
  longitude      Decimal?       @db.Decimal(9, 6)
  status         BusinessStatus @default(DRAFT)
  averageRating  Decimal        @default(0) @map("average_rating") @db.Decimal(3, 2)
  ratingCount    Int            @default(0) @map("rating_count")
  followerCount  Int            @default(0) @map("follower_count")
  websiteUrl     String?        @map("website_url")
  instagramUrl   String?        @map("instagram_url")
  facebookUrl    String?        @map("facebook_url")
  tiktokUrl      String?        @map("tiktok_url")
  // [{ platform, url }], one per platform; supersedes the three single-link columns above.
  socialLinks    Json?          @map("social_links")
  // Fulfilment settings (per shop). shippingFee null = platform default (FLAT_SHIPPING_FEE).
  pickupEnabled         Boolean  @default(true) @map("pickup_enabled")
  shippingEnabled       Boolean  @default(true) @map("shipping_enabled")
  localDeliveryEnabled  Boolean  @default(false) @map("local_delivery_enabled")
  shippingFee           Decimal? @map("shipping_fee") @db.Decimal(10, 2)
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(10, 2)
  localDeliveryFee      Decimal  @default(0) @map("local_delivery_fee") @db.Decimal(10, 2)
  localDeliveryRadiusKm Decimal? @map("local_delivery_radius_km") @db.Decimal(6, 2)
  translations   Json?
  sourceLocale   String?        @map("source_locale")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  ownerProfile BusinessOwnerProfile  @relation(fields: [ownerProfileId], references: [id])
  category     BusinessCategory?     @relation(fields: [categoryId], references: [id])
  logoAsset    MediaAsset?           @relation("BusinessLogo", fields: [logoAssetId], references: [id])
  coverAsset   MediaAsset?           @relation("BusinessCover", fields: [coverAssetId], references: [id])
  panoramaAsset MediaAsset?          @relation("BusinessPanorama", fields: [panoramaAssetId], references: [id])
  videoAsset    MediaAsset?          @relation("BusinessVideo", fields: [videoAssetId], references: [id])
  hours        BusinessHours[]
  subscription BusinessSubscription?
  products     Product[]
  workshops    Workshop[]
  shopRoutes   ShopRoute[]
  shopRoutesCreatedBy ShopRoute[] @relation("CreatedByBusiness")
  routeStops   RouteStop[]
  reviews      Review[]
  followers    Follower[]
  favorites    Favorite[]
  orders       Order[]
  payouts      Payout[]
  carts        Cart[]
  payments     Payment[]
  ledgerEntries BusinessLedgerEntry[]
  payoutAccounts PayoutAccount[]
  returnRequests ReturnRequest[]
  comments     Comment[]

  conversations Conversation[]
  employees     MerchantEmployee[]

  @@map("businesses")
}

model BusinessCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businesses BusinessesWithCategories[]
  Business   Business[]

  @@map("business_categories")
}

model BusinessesWithCategories {
  businessId String @map("business_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  category BusinessCategory @relation(fields: [categoryId], references: [id])

  @@id([businessId, categoryId])
  @@map("businesses_with_categories")
}

model BusinessHours {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") // 0=Sunday, 1=Monday...
  openTime   String?  @map("open_time")
  closeTime  String?  @map("close_time")
  isClosed   Boolean  @default(false) @map("is_closed")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

// ==========================================
// SUBSCRIPTIONS
// ==========================================

model SubscriptionPlan {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  slug         SubscriptionPlanSlug @unique
  description  String?
  monthlyPrice Decimal              @map("monthly_price") @db.Decimal(10, 2)
  /// Platform commission on sales in basis points (500 = 5%); null = platform default (COMMISSION_DEFAULT_BPS).
  commissionBps Int?                @map("commission_bps")
  currency     String               @default("EUR")
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  subscriptions BusinessSubscription[]

  @@map("subscription_plans")
}

model BusinessSubscription {
  id                   String             @id @default(uuid()) @db.Uuid
  businessId           String             @unique @map("business_id") @db.Uuid
  planId               String             @map("plan_id") @db.Uuid
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  provider             PaymentProvider?
  providerSubscriptionId String?          @map("provider_subscription_id")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  autoRenew            Boolean            @default(true) @map("auto_renew")
  cancelledAt          DateTime?          @map("cancelled_at")
  /// The period end for which the expiry reminder was already sent (one reminder per period).
  expiryReminderForEnd DateTime?          @map("expiry_reminder_for_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("business_subscriptions")
}

// ==========================================
// COMMERCE (PRODUCTS & ORDERS)
// ==========================================

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  name        String
  slug        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  stock       Int       @default(0)
  active      Boolean   @default(true)
  shopUrl     String?   @map("shop_url")
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  /// VAT percentage included in `price` (NL: 0, 9 or 21).
  vatRate     Decimal   @default(21) @map("vat_rate") @db.Decimal(4, 2)
  brand       String?
  weightGrams Int?      @map("weight_grams")
  lengthMm    Int?      @map("length_mm")
  widthMm     Int?      @map("width_mm")
  heightMm    Int?      @map("height_mm")
  /// Public product-page views (see ProductsService.recordView for what counts as a view).
  viewCount   Int       @default(0) @map("view_count")
  // Auto-translated copy of name/description: { en: {name, description}, nl: {...} }
  translations Json?
  sourceLocale String?  @map("source_locale")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  business   Business         @relation(fields: [businessId], references: [id])
  category   ProductCategory? @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]
  comments   Comment[]
  favorites  Favorite[]

  @@unique([businessId, slug])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  size      String?
  color     String?
  sku       String?
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("product_variants")
}

// ==========================================
// CART
// ==========================================

model Cart {
  id                String   @id @default(uuid()) @db.Uuid
  consumerProfileId String   @map("consumer_profile_id") @db.Uuid
  businessId        String?  @map("business_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id], onDelete: Cascade)
  business        Business?       @relation(fields: [businessId], references: [id])
  items           CartItem[]

  @@unique([consumerProfileId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  cartId     String   @map("cart_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  variantId  String?  @map("variant_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

/// One checkout by one customer; groups the per-store orders (Order = MerchantOrder) and is paid with one payment.
model CustomerOrder {
  id                String        @id @default(uuid()) @db.Uuid
  orderNumber       String        @unique @map("order_number")
  consumerProfileId String        @map("consumer_profile_id") @db.Uuid
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  totalAmount       Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency          String        @default("EUR")
  paidAt            DateTime?     @map("paid_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id])
  orders          Order[]
  payments        Payment[]

  @@index([consumerProfileId, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("customer_orders")
}

/// Per-store order ("MerchantOrder"). Belongs to a CustomerOrder (null for orders created before payments existed).
model Order {

  id                      String        @id @default(uuid()) @db.Uuid
  orderNumber             String        @unique @map("order_number")
  customerOrderId         String?       @map("customer_order_id") @db.Uuid
  fulfilmentMethod        FulfilmentMethod @default(SHIPPING) @map("fulfilment_method")
  consumerProfileId       String        @map("consumer_profile_id") @db.Uuid
  businessId              String        @map("business_id") @db.Uuid
  status                  OrderStatus   @default(PENDING)
  paymentStatus           PaymentStatus @default(PENDING) @map("payment_status")
  subtotalAmount          Decimal       @map("subtotal_amount") @db.Decimal(10, 2)
  deliveryFee             Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  totalAmount             Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency                String        @default("EUR")
  deliveryAddressSnapshot Json?         @map("delivery_address_snapshot")
  deliveryStreet          String?       @map("delivery_street")
  deliveryHouseNumber     String?       @map("delivery_house_number")
  deliveryCity            String?       @map("delivery_city")
  deliveryPostalCode      String?       @map("delivery_postal_code")
  deliveryCountry         String        @default("NL") @map("delivery_country")
  deliveryNotes           String?       @map("delivery_notes")
  latitude                Decimal?      @db.Decimal(9, 6)
  longitude               Decimal?      @db.Decimal(9, 6)
  confirmedAt             DateTime?     @map("confirmed_at")
  deliveredAt             DateTime?     @map("delivered_at")
  cancelledAt             DateTime?     @map("cancelled_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  consumerProfile ConsumerProfile    @relation(fields: [consumerProfileId], references: [id])
  customerOrder   CustomerOrder?     @relation(fields: [customerOrderId], references: [id])
  business        Business           @relation(fields: [businessId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  statusEvents    OrderStatusEvent[]
  reviews         Review[]
  ledgerEntries   BusinessLedgerEntry[]
  returnRequests  ReturnRequest[]

  @@index([customerOrderId])
  @@index([businessId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productVariantId    String?  @map("product_variant_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot")
  variantSnapshot     String?  @map("variant_snapshot")
  unitPrice           Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity            Int
  subtotalPrice       Decimal  @map("subtotal_price") @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id])
  returnItems    ReturnItem[]

  @@map("order_items")
}

model OrderStatusEvent {
  id              String      @id @default(uuid()) @db.Uuid
  orderId         String      @map("order_id") @db.Uuid
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?     @map("changed_by_user_id") @db.Uuid
  reason          String?
  createdAt       DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_events")
}

// ==========================================
// WORKSHOPS & SHOP ROUTES
// ==========================================

model Workshop {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  title       String
  slug        String
  description String?
  price       Decimal        @db.Decimal(10, 2)
  capacity    Int
  bookedCount Int            @default(0) @map("booked_count")
  startTime   DateTime       @map("start_time")
  endTime     DateTime       @map("end_time")
  location    String?
  latitude    Decimal?       @db.Decimal(9, 6)
  longitude   Decimal?       @db.Decimal(9, 6)
  imageUrl    String?        @map("image_url")
  imageAssetId String?       @map("image_asset_id") @db.Uuid
  /// Participants cancelling at least this many hours before a session start get `refundPercentage` back.
  cancellationDeadlineHours Int @default(48) @map("cancellation_deadline_hours")
  refundPercentage Int @default(100) @map("refund_percentage")
  minAge      Int?           @map("min_age")
  translations Json?
  sourceLocale String?       @map("source_locale")
  status      WorkshopStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  business   Business          @relation(fields: [businessId], references: [id])
  imageAsset MediaAsset?        @relation(fields: [imageAssetId], references: [id])
  bookings   WorkshopBooking[]
  sessions   WorkshopSession[]
  reviews    Review[]
  comments   Comment[]

  @@unique([businessId, slug])
  @@map("workshops")
}

model WorkshopBooking {
  id                String        @id @default(uuid()) @db.Uuid
  workshopId        String        @map("workshop_id") @db.Uuid
  sessionId         String?       @map("session_id") @db.Uuid
  consumerProfileId String        @map("consumer_profile_id") @db.Uuid
  ticketQuantity    Int           @default(1) @map("ticket_quantity")
  unitPrice         Decimal       @default(0) @map("unit_price") @db.Decimal(10, 2)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(10, 2)
  status            BookingStatus @default(PENDING)
  cancelledAt       DateTime?     @map("cancelled_at")
  /// Share of the paid amount owed back after a cancellation, per the workshop's policy.
  refundPercent     Int?          @map("refund_percent")
  refundAmount      Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  workshop        Workshop        @relation(fields: [workshopId], references: [id])
  session         WorkshopSession? @relation(fields: [sessionId], references: [id])
  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id])
  payments        Payment[]
  ledgerEntries   BusinessLedgerEntry[]

  @@map("workshop_bookings")
}

model ShopRoute {
  id                  String      @id @default(uuid()) @db.Uuid
  businessId          String?     @map("business_id") @db.Uuid
  createdByBusinessId String?     @map("created_by_business_id") @db.Uuid
  createdByUserId     String?     @map("created_by_user_id") @db.Uuid
  title               String
  slug                String
  description         String?
  city                String
  status              RouteStatus @default(DRAFT)
  theme               String?
  coverImageUrl       String?     @map("cover_image_url")
  /// Total length in km and estimated duration; computed from the stops unless `statsManual`.
  distanceKm          Decimal?    @map("distance_km") @db.Decimal(6, 2)
  durationMinutes     Int?        @map("duration_minutes")
  statsManual         Boolean     @default(false) @map("stats_manual")
  featured            Boolean     @default(false)
  translations        Json?
  sourceLocale        String?     @map("source_locale")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  deletedAt           DateTime?   @map("deleted_at")

  business         Business?           @relation(fields: [businessId], references: [id])
  stops            RouteStop[]
  createdByBusiness Business?           @relation("CreatedByBusiness", fields: [createdByBusinessId], references: [id])

  @@unique([businessId, slug])
  @@map("shop_routes")
}

model RouteStop {
  id          String   @id @default(uuid()) @db.Uuid
  routeId     String   @map("route_id") @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  title       String
  sequence    Int
  latitude    Decimal  @db.Decimal(9, 6)
  longitude   Decimal  @db.Decimal(9, 6)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  route   ShopRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  business Business  @relation(fields: [businessId], references: [id])

  @@unique([routeId, sequence])
  @@unique([routeId, businessId])
  @@map("route_stops")
}

// ==========================================
// REVIEWS & SOCIAL
// ==========================================

model Review {
  id                String       @id @default(uuid()) @db.Uuid
  businessId        String       @map("business_id") @db.Uuid
  consumerProfileId String       @map("consumer_profile_id") @db.Uuid
  productId         String?      @map("product_id") @db.Uuid
  workshopId        String?      @map("workshop_id") @db.Uuid
  orderId           String?      @map("order_id") @db.Uuid
  rating            Int
  title             String?
  comment           String
  status            ReviewStatus @default(PUBLISHED)
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  business        Business        @relation(fields: [businessId], references: [id])
  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id])
  product         Product?        @relation(fields: [productId], references: [id])
  workshop        Workshop?       @relation(fields: [workshopId], references: [id])
  order           Order?          @relation(fields: [orderId], references: [id])
  images          ReviewImage[]

  @@map("reviews")
}

model ReviewImage {
  id           String   @id @default(uuid()) @db.Uuid
  reviewId     String   @map("review_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  review     Review     @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@map("review_images")
}

model Follower {
  id                String   @id @default(uuid()) @db.Uuid
  consumerProfileId String   @map("consumer_profile_id") @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id], onDelete: Cascade)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([consumerProfileId, businessId])
  @@map("followers")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  linkUrl   String?          @map("link_url")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

/// Per-user switches for which in-app notifications a shop owner receives.
model NotificationPreference {
  userId        String   @id @map("user_id") @db.Uuid
  notifyOrders  Boolean  @default(true) @map("notify_orders")
  notifyReviews Boolean  @default(true) @map("notify_reviews")
  notifyTips    Boolean  @default(true) @map("notify_tips")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ==========================================
// PAYMENTS & PAYOUTS
// ==========================================

model Payment {
  id                     String         @id @default(uuid()) @db.Uuid
  purpose                PaymentPurpose
  provider               PaymentProvider
  method                 PaymentMethod?
  status                 PaymentStatus  @default(PENDING)
  amount                 Decimal        @db.Decimal(10, 2)
  currency               String         @default("EUR")
  providerTransactionId  String?        @map("provider_transaction_id")
  businessSubscriptionId String?        @map("business_subscription_id") @db.Uuid
  orderId                String?        @map("order_id") @db.Uuid
  workshopBookingId      String?        @map("workshop_booking_id") @db.Uuid
  customerOrderId        String?        @map("customer_order_id") @db.Uuid
  /// Hosted checkout page of the provider while the payment is open.
  checkoutUrl            String?        @map("checkout_url")
  paidAt                 DateTime?      @map("paid_at")
  refundedAt             DateTime?      @map("refunded_at")
  userId                 String?        @map("user_id") @db.Uuid
  businessId             String?        @map("business_id") @db.Uuid
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  businessSubscription BusinessSubscription? @relation(fields: [businessSubscriptionId], references: [id])
  order                Order?                @relation(fields: [orderId], references: [id])
  customerOrder        CustomerOrder?        @relation(fields: [customerOrderId], references: [id])
  workshopBooking      WorkshopBooking?      @relation(fields: [workshopBookingId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  business             Business?             @relation(fields: [businessId], references: [id])
  ledgerEntries        BusinessLedgerEntry[]

  @@index([providerTransactionId])
  @@index([customerOrderId])
  @@map("payments")
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  businessId       String       @map("business_id") @db.Uuid
  amount           Decimal      @db.Decimal(10, 2)
  currency         String       @default("EUR")
  status           PayoutStatus @default(PENDING)
  iban             String?
  accountHolder    String?      @map("account_holder")
  adminNotes       String?      @map("admin_notes")
  requestedByUserId String?     @map("requested_by_user_id") @db.Uuid
  /// Weekly run key (e.g. 2026-W43); with business_id it makes the run idempotent. Null for manual payouts.
  periodKey        String?      @map("period_key")
  /// IBAN snapshot at the time of the run, encrypted (AES-256-GCM); never returned by the API.
  ibanEncrypted    String?      @map("iban_encrypted")
  approvedByUserId String?      @map("approved_by_user_id") @db.Uuid
  rejectedReason   String?      @map("rejected_reason")
  providerReference String?     @map("provider_reference")
  requestedAt      DateTime     @map("requested_at")
  approvedAt       DateTime?    @map("approved_at")
  paidAt           DateTime?    @map("paid_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  business       Business @relation(fields: [businessId], references: [id])
  requestedBy    User?    @relation("PayoutRequestedBy", fields: [requestedByUserId], references: [id])
  approvedBy     User?    @relation("PayoutApprovedBy", fields: [approvedByUserId], references: [id])
  ledgerEntries  BusinessLedgerEntry[]

  @@unique([businessId, periodKey])
  @@map("payouts")
}

// ==========================================
// MEDIA ASSETS
// ==========================================

model MediaAsset {
  id        String   @id @default(uuid()) @db.Uuid
  url       String
  mimeType  String   @map("mime_type")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  consumerProfiles       ConsumerProfile[]
  businessOwnerProfiles BusinessOwnerProfile[]
  businessLogos         Business[]              @relation("BusinessLogo")
  businessCovers        Business[]              @relation("BusinessCover")
  businessPanoramas     Business[]              @relation("BusinessPanorama")
  businessVideos        Business[]              @relation("BusinessVideo")
  productImages         ProductImage[]
  workshops             Workshop[]
  reviewImages          ReviewImage[]
  chatAttachments       ChatMessage[]           @relation("ChatAttachment")

  @@map("media_assets")
}

// ==========================================
// AUDIT LOGS
// ==========================================

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  action    String  @map("action")
  targetType String  @map("target_type")
  targetId  String? @map("target_id") @db.Uuid
  metadata  Json?   @map("metadata")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("AuditLogActor", fields: [actorUserId], references: [id])

  @@map("audit_logs")
}

// ==========================================
// REPORTS
// ==========================================

model Report {
  id              String   @id @default(uuid()) @db.Uuid
  reporterUserId  String  @map("reporter_user_id") @db.Uuid
  targetType     String  @map("target_type")
  targetId       String  @map("target_id") @db.Uuid
  reason         String  @map("reason")
  details        String? @map("details")
  status         String  @default("OPEN") @map("status")
  resolvedByUserId String? @map("resolved_by_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  reporter   User @relation("ReportReporter", fields: [reporterUserId], references: [id])
  resolvedBy User? @relation("ReportResolvedBy", fields: [resolvedByUserId], references: [id])

  @@map("reports")
}

// ==========================================
// PAYMENT WEBHOOK EVENTS
// ==========================================

model PaymentWebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  provider        PaymentProvider @map("provider")
  providerEventId String  @map("provider_event_id")
  eventType       String  @map("event_type")
  payload         Json    @map("payload")
  processed       Boolean @default(false) @map("processed")
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@map("payment_webhook_events")
}

// ==========================================
// BUSINESS LEDGER ENTRIES
// ==========================================

model BusinessLedgerEntry {
  id               String   @id @default(uuid()) @db.Uuid
  businessId       String  @map("business_id") @db.Uuid
  paymentId        String? @map("payment_id") @db.Uuid
  orderId          String? @map("order_id") @db.Uuid
  workshopBookingId String? @map("workshop_booking_id") @db.Uuid
  payoutId         String? @map("payout_id") @db.Uuid
  type             String  @map("type")
  amountCents      Int     @map("amount_cents")
  currency         String  @default("EUR") @map("currency")
  /// Commission rate in basis points that applied to a COMMISSION entry (used to reverse it on refunds).
  rateBps          Int?    @map("rate_bps")
  availableAt      DateTime? @map("available_at")
  createdAt        DateTime @default(now()) @map("created_at")

  business    Business    @relation(fields: [businessId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])
  order       Order?      @relation(fields: [orderId], references: [id])
  workshopBooking WorkshopBooking? @relation(fields: [workshopBookingId], references: [id])
  payout      Payout?     @relation(fields: [payoutId], references: [id])

  @@map("business_ledger_entries")
}

// ==========================================
// PAYOUT ACCOUNTS
// ==========================================

model PayoutAccount {
  id                String   @id @default(uuid()) @db.Uuid
  businessId        String  @map("business_id") @db.Uuid
  provider          PaymentProvider? @map("provider")
  accountHolderName String? @map("account_holder_name")
  ibanLast4         String? @map("iban_last4")
  /// Full IBAN, encrypted at rest (AES-256-GCM, key ENCRYPTION_KEY). Decrypted only for the payout export.
  ibanEncrypted     String? @map("iban_encrypted")
  providerAccountId String? @map("provider_account_id")
  status            String  @default("PENDING") @map("status")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId])
  @@map("payout_accounts")
}

// ==========================================
// CONSUMER ADDRESSES
// ==========================================

model ConsumerAddress {
  id              String   @id @default(uuid()) @db.Uuid
  consumerProfileId String  @map("consumer_profile_id") @db.Uuid
  label           String  @map("label")
  fullName        String  @map("full_name")
  phone           String? @map("phone")
  street          String  @map("street")
  houseNumber     String? @map("house_number")
  postalCode      String? @map("postal_code")
  city            String  @map("city")
  countryCode     String  @default("NL") @map("country_code")
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  isDefault       Boolean @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id])

  @@map("consumer_addresses")
}

// ==========================================
// COMMENTS
// ==========================================

model Comment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String  @map("user_id") @db.Uuid
  businessId      String  @map("business_id") @db.Uuid
  productId       String? @map("product_id") @db.Uuid
  workshopId      String? @map("workshop_id") @db.Uuid
  parentCommentId String? @map("parent_comment_id") @db.Uuid
  body            String  @map("body")
  status          String  @default("PUBLISHED") @map("status")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  user     User     @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  product  Product? @relation(fields: [productId], references: [id])
  workshop Workshop? @relation(fields: [workshopId], references: [id])
  parent   Comment? @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@map("comments")
}

// ==========================================
// SHOP REGISTRATIONS (Join Local Spotter — shop-owner pilot signup)
// ==========================================

model ShopRegistration {
  id                 String   @id @default(uuid()) @db.Uuid
  shopName           String   @map("shop_name")
  contactPersonName  String   @map("contact_person_name")
  email              String   @map("email")
  phone              String?  @map("phone")
  shopAddress        String   @map("shop_address")
  websiteInstagram   String?  @map("website_instagram")
  shopType           String   @map("shop_type")
  otherShopType      String?  @map("other_shop_type")
  productCount       String?  @map("product_count")
  sellsOnline        String?  @map("sells_online")
  otherSellsOnline   String?  @map("other_sells_online")
  webshopPos         String?  @map("webshop_pos")
  otherWebshopPos    String?  @map("other_webshop_pos")
  pilotInterest      String   @map("pilot_interest")
  valuableFeatures   String[] @default([]) @map("valuable_features")
  otherFeature       String?  @map("other_feature")
  monthlyPrice       String?  @map("monthly_price")
  pricingModel       String?  @map("pricing_model")
  routeInterest      String?  @map("route_interest")
  routeOffer         String?  @map("route_offer")
  otherRouteOffer    String?  @map("other_route_offer")
  biggestChallenge   String?  @map("biggest_challenge")
  source             String   @default("website_widget") @map("source")
  status             String   @default("NEW") @map("status")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("shop_registrations")
}

// ==========================================
// CHAT (consumer <-> shop)
// ==========================================

model Conversation {
  id                String   @id @default(uuid()) @db.Uuid
  consumerProfileId String   @map("consumer_profile_id") @db.Uuid
  businessId        String   @map("business_id") @db.Uuid
  lastMessageAt     DateTime @default(now()) @map("last_message_at")
  createdAt         DateTime @default(now()) @map("created_at")
  /// Set when the consumer / the shop blocked the conversation. While either is set nobody can send.
  consumerBlockedAt DateTime? @map("consumer_blocked_at")
  businessBlockedAt DateTime? @map("business_blocked_at")
  /// Set when the recipient was notified of unread messages; cleared when they read. One notification per unread burst.
  consumerNotifiedAt DateTime? @map("consumer_notified_at")
  businessNotifiedAt DateTime? @map("business_notified_at")

  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id], onDelete: Cascade)
  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages        ChatMessage[]
  reports         ChatReport[]

  @@unique([consumerProfileId, businessId])
  @@index([businessId, lastMessageAt])
  @@index([consumerProfileId, lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderUserId   String    @map("sender_user_id") @db.Uuid
  body           String
  attachmentAssetId String?  @map("attachment_asset_id") @db.Uuid
  /// true = written by the shop side (owner or an employee), false = by the consumer.
  fromBusiness   Boolean   @default(false) @map("from_business")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  attachment   MediaAsset?  @relation("ChatAttachment", fields: [attachmentAssetId], references: [id], onDelete: SetNull)
  reports      ChatReport[]

  @@index([conversationId, createdAt])
  @@index([createdAt])
  @@map("chat_messages")
}

enum ChatReportReason {
  SPAM
  HARASSMENT
  FRAUD
  INAPPROPRIATE
  OTHER
}

enum ChatReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A participant's report of a chat message (or of the other party in general). The message text is
/// snapshotted so moderators can still review it after the retention job removes the message.
model ChatReport {
  id               String           @id @default(uuid()) @db.Uuid
  conversationId   String           @map("conversation_id") @db.Uuid
  messageId        String?          @map("message_id") @db.Uuid
  reporterUserId   String           @map("reporter_user_id") @db.Uuid
  reportedUserId   String?         @map("reported_user_id") @db.Uuid
  reason           ChatReportReason
  details          String?
  messageSnapshot  String?          @map("message_snapshot")
  status           ChatReportStatus @default(OPEN)
  resolutionNote   String?          @map("resolution_note")
  resolvedByUserId String?          @map("resolved_by_user_id") @db.Uuid
  resolvedAt       DateTime?        @map("resolved_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      ChatMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  reporter     User         @relation("ChatReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([reporterUserId, messageId])
  @@index([status, createdAt])
  @@map("chat_reports")
}


/// A consumer's saved product or store. Exactly one of productId / businessId is set.
model Favorite {
  id                String   @id @default(uuid()) @db.Uuid
  consumerProfileId String   @map("consumer_profile_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  businessId        String?  @map("business_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  business        Business?       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([consumerProfileId, productId])
  @@unique([consumerProfileId, businessId])
  @@index([productId])
  @@index([businessId])
  @@map("favorites")
}


model WorkshopSession {
  id          String        @id @default(uuid()) @db.Uuid
  workshopId  String        @map("workshop_id") @db.Uuid
  startTime   DateTime      @map("start_time")
  endTime     DateTime      @map("end_time")
  capacity    Int
  bookedCount Int           @default(0) @map("booked_count")
  status      SessionStatus @default(OPEN)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workshop Workshop          @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  bookings WorkshopBooking[]

  @@index([workshopId, startTime])
  @@map("workshop_sessions")
}


enum EmployeeRole {
  MANAGER
  STAFF
}

enum EmployeeStatus {
  INVITED
  ACTIVE
  REVOKED
}

/// A person who works for a shop without owning it. MVP scope: chat and workshop participants
/// (orders follow with the order rewrite). Products, settings, subscription and payouts stay owner-only.
model MerchantEmployee {
  id              String         @id @default(uuid()) @db.Uuid
  businessId      String         @map("business_id") @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  email           String
  role            EmployeeRole   @default(STAFF)
  status          EmployeeStatus @default(INVITED)
  inviteTokenHash String?        @unique @map("invite_token_hash")
  inviteExpiresAt DateTime?      @map("invite_expires_at")
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  acceptedAt      DateTime?      @map("accepted_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation("EmployeeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([userId, status])
  @@map("merchant_employees")
}

// ==========================================
// RETURNS (RMA)
// ==========================================

model ReturnRequest {
  id                String       @id @default(uuid()) @db.Uuid
  returnNumber      String       @unique @map("return_number")
  orderId           String       @map("order_id") @db.Uuid
  consumerProfileId String       @map("consumer_profile_id") @db.Uuid
  businessId        String       @map("business_id") @db.Uuid
  status            ReturnStatus @default(REQUESTED)
  reason            String
  merchantNote      String?      @map("merchant_note")
  /// Set when the shop confirms receipt: what is paid back (items, plus delivery when everything is returned).
  refundAmountCents Int?         @map("refund_amount_cents")
  /// REFUNDED | NOT_REQUIRED | FAILED (a failed refund can be retried by the shop or an admin).
  refundStatus      String?      @map("refund_status")
  restocked         Boolean      @default(false)
  decidedByUserId   String?      @map("decided_by_user_id") @db.Uuid
  requestedAt       DateTime     @default(now()) @map("requested_at")
  decidedAt         DateTime?    @map("decided_at")
  receivedAt        DateTime?    @map("received_at")
  refundedAt        DateTime?    @map("refunded_at")
  cancelledAt       DateTime?    @map("cancelled_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  order           Order           @relation(fields: [orderId], references: [id])
  consumerProfile ConsumerProfile @relation(fields: [consumerProfileId], references: [id])
  business        Business        @relation(fields: [businessId], references: [id])
  items           ReturnItem[]

  @@index([orderId])
  @@index([businessId, status, createdAt])
  @@index([consumerProfileId, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String   @id @default(uuid()) @db.Uuid
  returnRequestId String   @map("return_request_id") @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  quantity        Int

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@map("return_items")
}
