# Server-side only. Where Next.js proxies /api/v1/* to (NestJS API origin, no path).
# Local development:
BACKEND_URL=http://localhost:4000

# On Vercel set BACKEND_URL to the publicly reachable backend, e.g.
#   BACKEND_URL=https://your-backend.onrender.com
# The browser never calls the backend directly: it calls /api/v1 on the frontend
# origin, so the HttpOnly session cookie stays first-party. The backend's
# CORS_ORIGIN / FRONTEND_URL must include the frontend's public origin
# (used for the CSRF origin check).

# SMS codes (sign-up, login, password reset) and order SMS are sent by the backend (Bird). No frontend setting needed.

# Social login (public identifiers; buttons only show when set). Backend needs GOOGLE_CLIENT_ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Help & Support page: contact email (hidden when empty)
# NEXT_PUBLIC_SUPPORT_EMAIL=

# Supabase Storage host only, e.g. abcdefgh.supabase.co (images, video and direct uploads; added to the CSP).
# SUPABASE_STORAGE_HOST=

# Which deployment this is: "public" (www, consumers and shop owners; /admin is 404) or "admin" (admin.<domain>,
# only /admin and the sign-in pages; noindex). Two Vercel projects, same code.
# NEXT_PUBLIC_PORTAL=public
