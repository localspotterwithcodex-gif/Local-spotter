# Local development (matches backend/.env.example: PORT=4000, API_PREFIX=/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# When deploying the frontend to Vercel, set this in the Vercel project's
# Environment Variables to your PUBLICLY REACHABLE backend URL, e.g.:
#   NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
# A deployed frontend can NEVER reach "http://localhost:4000" — that
# address only exists on your own machine. If this isn't set correctly for
# the Vercel deployment, every login/signup/API call will fail with a
# "Kan geen verbinding maken met de server" error. See PROMPT.md for the
# full explanation.
