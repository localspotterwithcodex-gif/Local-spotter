# Server-side only. Where Next.js proxies /api/v1/* to (NestJS API origin, no path).
# Local development:
BACKEND_URL=http://localhost:4000

# On Vercel set BACKEND_URL to the publicly reachable backend, e.g.
#   BACKEND_URL=https://your-backend.onrender.com
# The browser never calls the backend directly: it calls /api/v1 on the frontend
# origin, so the HttpOnly session cookie stays first-party. The backend's
# CORS_ORIGIN / FRONTEND_URL must include the frontend's public origin
# (used for the CSRF origin check).

# Optional: shop-registration widget storage (legacy MongoDB route)
# MONGODB_URI=

# Mobile-number sign-up needs an SMS provider (none is free for production).
# Leave unset/false: the sign-up form then asks users to register with email.
# NEXT_PUBLIC_SMS_ENABLED=false
